  /* ==================== MULTI-ROOM VISUALIZER ==================== */
  function selectVisualizerRoom(roomId) {
    state.selectedVisualizerRoomId = roomId;
    renderRoomTabs();
    renderClassroomLayout();
  }

  function renderRoomTabs() {
    const tabContainer = document.getElementById('roomSelectorTabs');
    if (!tabContainer) return;
    tabContainer.innerHTML = '';

    state.rooms.forEach(room => {
      const btn = document.createElement('button');
      btn.className = `room-tab-btn ${room.id === state.selectedVisualizerRoomId ? 'active' : ''}`;
      btn.innerText = room.name.split(' (')[0];
      btn.onclick = () => selectVisualizerRoom(room.id);
      tabContainer.appendChild(btn);
    });
  }

  function renderClassroomLayout() {
    const grid = document.getElementById('seatingGrid');
    const floorplan = document.getElementById('classroomFloorplan');
    const countLabel = document.getElementById('studentCountLabel');
    const fixtureBadges = document.getElementById('activeRoomFixtureBadges');
    const focalPoint = document.getElementById('roomFocalPoint');
    const titleEl = document.getElementById('visualizerTitle');

    if (!grid || !floorplan || !fixtureBadges) return;

    const currentRoom = state.rooms.find(r => r.id === state.selectedVisualizerRoomId);
    if (!currentRoom) return;

    const cap = currentRoom.capacity || 20;

    if (titleEl) {
      titleEl.innerText = `Visual Floorplan: ${currentRoom.name} (${cap} Occupants Max)`;
    }

    if (focalPoint) {
      focalPoint.innerText = currentRoom.focalLabel || "FRONT OF ROOM";
    }

    grid.innerHTML = '';
    countLabel.innerText = `${currentRoom.occupants} / ${cap}`;

    // Render slots (6 for hostel, 20 for lab/class)
    for (let i = 1; i <= cap; i++) {
      const isOccupied = i <= currentRoom.occupants;
      const desk = document.createElement('div');
      desk.className = `desk ${isOccupied ? 'occupied' : 'vacant'}`;
      desk.onclick = () => toggleSeat(i);
      
      const prefix = currentRoom.unitType === 'Bed' ? 'B' : 'S';
      desk.innerHTML = `
        <div class="desk-seat"></div>
        <span class="desk-label">${prefix}-${i}</span>
      `;
      grid.appendChild(desk);
    }

    // Dynamic Fixture Badges (AC, Geyser, Lights, Projector)
    fixtureBadges.innerHTML = '';
    currentRoom.appliances.forEach(app => {
      const badge = document.createElement('div');
      let statusClass = '';
      if (app.on) {
        statusClass = app.type === 'hazard' ? 'active-hazard' : 'active-load';
      }
      badge.className = `appliance-badge ${statusClass}`;
      badge.innerHTML = `${app.icon || '⚡'} ${app.name}`;
      fixtureBadges.appendChild(badge);
    });

    // Dark theme override if room lights are switched OFF
    const lightApp = currentRoom.appliances.find(a => 
      a.type === 'ambient' && (a.name.toLowerCase().includes('light') || a.name.toLowerCase().includes('illumination'))
    );
    if (lightApp && !lightApp.on) {
      floorplan.classList.add('lights-out');
    } else {
      floorplan.classList.remove('lights-out');
    }
  }

  function adjustStudentCount(delta) {
    const currentRoom = state.rooms.find(r => r.id === state.selectedVisualizerRoomId);
    if (!currentRoom) return;

    const cap = currentRoom.capacity || 20;
    const nextVal = Math.max(0, Math.min(cap, currentRoom.occupants + delta));
    currentRoom.occupants = nextVal;

    // Automatic presence synchronization with the sensor engine
    if (nextVal === 0 && currentRoom.presence === 'occupied') {
      forceRoomPresence(currentRoom.id, 'vacant');
    } else if (nextVal > 0 && currentRoom.presence === 'vacant') {
      forceRoomPresence(currentRoom.id, 'occupied');
    }

    renderClassroomLayout();
    renderSimControls();
  }

  function toggleSeat(seatIndex) {
    const currentRoom = state.rooms.find(r => r.id === state.selectedVisualizerRoomId);
    if (!currentRoom) return;

    if (seatIndex <= currentRoom.occupants) {
      adjustStudentCount(-1);
    } else {
      adjustStudentCount(1);
    }
  }

  /* ==================== DRAGGABLE CONTROLLER ==================== */
  function initDraggablePanel() {
    const panel = document.getElementById('draggableSimPanel');
    const handle = document.getElementById('simDragHandle');
    let isDragging = false;
    let startX, startY, initialLeft, initialTop;

    handle.addEventListener('mousedown', (e) => {
      isDragging = true;
      startX = e.clientX;
      startY = e.clientY;

      const rect = panel.getBoundingClientRect();
      initialLeft = rect.left;
      initialTop = rect.top;

      panel.style.left = initialLeft + 'px';
      panel.style.top = initialTop + 'px';
      panel.style.right = 'auto';
      panel.style.bottom = 'auto';

      document.body.style.userSelect = 'none';
    });

    document.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
      const dx = e.clientX - startX;
      const dy = e.clientY - startY;

      let nextX = initialLeft + dx;
      let nextY = initialTop + dy;

      const maxX = window.innerWidth - panel.offsetWidth;
      const maxY = window.innerHeight - panel.offsetHeight;

      panel.style.left = Math.max(10, Math.min(nextX, maxX - 10)) + 'px';
      panel.style.top = Math.max(10, Math.min(nextY, maxY - 10)) + 'px';
    });

    document.addEventListener('mouseup', () => {
      isDragging = false;
      document.body.style.userSelect = 'auto';
    });

    handle.addEventListener('touchstart', (e) => {
      isDragging = true;
      const touch = e.touches[0];
      startX = touch.clientX;
      startY = touch.clientY;

      const rect = panel.getBoundingClientRect();
      initialLeft = rect.left;
      initialTop = rect.top;

      panel.style.left = initialLeft + 'px';
      panel.style.top = initialTop + 'px';
      panel.style.right = 'auto';
      panel.style.bottom = 'auto';
    }, { passive: true });

    document.addEventListener('touchmove', (e) => {
      if (!isDragging) return;
      const touch = e.touches[0];
      const dx = touch.clientX - startX;
      const dy = touch.clientY - startY;

      let nextX = initialLeft + dx;
      let nextY = initialTop + dy;

      const maxX = window.innerWidth - panel.offsetWidth;
      const maxY = window.innerHeight - panel.offsetHeight;

      panel.style.left = Math.max(10, Math.min(nextX, maxX - 10)) + 'px';
      panel.style.top = Math.max(10, Math.min(nextY, maxY - 10)) + 'px';
    }, { passive: true });

    document.addEventListener('touchend', () => {
      isDragging = false;
    });
  }

  /* ==================== LEADERBOARD & UI ENGINES ==================== */
  function updateLeaderboardDynamically(blockId, savedWatts) {
    const addedKwh = parseFloat(((savedWatts * 0.5) / 1000).toFixed(2));
    
    state.leaderboard.forEach(item => {
      if (item.id === blockId) {
        item.avoidedKwh = parseFloat((item.avoidedKwh + addedKwh).toFixed(1));
        item.rawScore = Math.min(99.9, parseFloat((item.rawScore + (addedKwh * 0.4)).toFixed(1)));
      } else {
        const ambientStep = (Math.random() * 0.08);
        item.avoidedKwh = parseFloat((item.avoidedKwh + ambientStep).toFixed(1));
        item.rawScore = Math.min(99.9, Math.max(70.0, parseFloat((item.rawScore + (Math.random() * 0.04 - 0.02)).toFixed(1))));
      }
    });

    state.leaderboard.sort((a, b) => (b.rawScore + b.avoidedKwh) - (a.rawScore + a.avoidedKwh));

    const avgScore = (state.leaderboard.reduce((acc, cur) => acc + cur.rawScore, 0) / state.leaderboard.length).toFixed(1);
    const ecoEl = document.getElementById('campusEcoScore');
    if (ecoEl) ecoEl.innerText = `${avgScore}%`;

    const totalAvoided = state.leaderboard.reduce((acc, cur) => acc + cur.avoidedKwh, 0).toFixed(1);
    const avoidedText = document.getElementById('totalAvoidedKwhText');
    if (avoidedText) avoidedText.innerText = `~ ${totalAvoided} kWh`;

    renderLeaderboard();
  }

  function renderLeaderboard() {
    const container = document.getElementById('campusLeaderboard');
    if (!container) return;
    container.innerHTML = '';

    state.leaderboard.forEach((item, index) => {
      const currentRank = index + 1;
      let statusText = "Steady";
      if (item.prevRank && currentRank < item.prevRank) statusText = `▲ +${item.prevRank - currentRank} Rank`;
      else if (item.prevRank && currentRank > item.prevRank) statusText = `▼ -${currentRank - item.prevRank} Rank`;
      else if (currentRank === 1) statusText = "Leading";

      item.prevRank = currentRank;

      let rankClass = "rank-other";
      if (currentRank === 1) rankClass = "rank-1";
      else if (currentRank === 2) rankClass = "rank-2";
      else if (currentRank === 3) rankClass = "rank-3";

      const row = document.createElement('div');
      row.className = 'leaderboard-item';
      row.innerHTML = `
        <div style="display:flex; align-items:center; gap:12px;">
          <div class="rank-badge ${rankClass}">#${currentRank}</div>
          <div class="block-info">
            <h4>${item.name}</h4>
            <p>Saved: <strong>${item.avoidedKwh} kWh</strong> • <span style="color:${statusText.includes('▲') ? 'var(--success)' : (statusText.includes('▼') ? 'var(--danger)' : 'var(--text-muted)')}">${statusText}</span></p>
          </div>
        </div>
        <div class="score-val">${item.rawScore.toFixed(1)}%</div>
      `;
      container.appendChild(row);
    });

    const tt = state.leaderboard.find(b => b.id === "tt");
    const ttRank = state.leaderboard.findIndex(b => b.id === "tt") + 1;
    
    const rankBadge = document.getElementById('userBlockRankBadge');
    if (rankBadge) rankBadge.innerText = `Campus Rank #${ttRank}`;

    const desc = document.getElementById('userBlockDesc');
    if (desc && tt) {
      desc.innerHTML = `Your assigned zone (<strong>Technology Tower - TT</strong>) currently holds <strong>Rank #${ttRank}</strong> across VIT campus, avoiding <strong>${tt.avoidedKwh} kWh</strong> with an efficiency score of <strong>${tt.rawScore.toFixed(1)}%</strong>.`;
    }
  }

  function switchRole(role) {
    state.currentRole = role;
    document.querySelectorAll('.role-btn').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.view-section').forEach(v => v.classList.remove('active'));
    
    if (role === 'admin') {
      document.querySelectorAll('.role-btn')[0].classList.add('active');
      document.getElementById('adminView').classList.add('active');
      renderAdminRooms();
    } else {
      document.querySelectorAll('.role-btn')[1].classList.add('active');
      document.getElementById('userView').classList.add('active');
      renderUserPortal();
    }
  }

  function renderAdminRooms() {
    const container = document.getElementById('adminRoomGrid');
    if (!container) return;
    container.innerHTML = '';

    state.rooms.forEach(room => {
      let roomTotalWatts = room.appliances.reduce((acc, a) => a.on ? acc + a.baseWatts : acc, 0);
      const isHazard = room.appliances.some(a => a.on && a.type === 'hazard' && room.presence === 'vacant' && room.unattendedMinutes >= 5);

      const card = document.createElement('div');
      card.className = `room-box ${isHazard ? 'hazard-border' : ''}`;
      
      let presenceTag = `<span class="badge-tag tag-occupied">Occupied (${room.occupants})</span>`;
      if (isHazard) {
        presenceTag = `<span class="badge-tag tag-hazard">Hazard: ${room.unattendedMinutes}m Unattended</span>`;
      } else if (room.presence === 'vacant' || !room.radarVitalDetected) {
        presenceTag = `<span class="badge-tag tag-vacant">Vacant (${room.unattendedMinutes}m)</span>`;
      }

      let appliancesHTML = room.appliances.map(app => `
        <div class="appliance-row">
          <div>
            <div class="appliance-name">
              ${app.icon || ''} ${app.name} 
              ${app.type === 'hazard' ? '<span style="color:var(--danger)">[Hazard: 5m]</span>' : (app.type === 'ac' ? '<span style="color:var(--primary)">[AC: 15m]</span>' : '<span style="color:var(--text-muted)">[Light/Fan: 20m]</span>')}
            </div>
            <div class="appliance-draw">${app.on ? app.baseWatts + ' W' : '0 W (Off)'}</div>
          </div>
          <label class="switch">
            <input type="checkbox" ${app.on ? 'checked' : ''} onchange="toggleAppliance('${room.id}', '${app.id}')">
            <span class="slider"></span>
          </label>
        </div>
      `).join('');

      card.innerHTML = `
        <div class="room-header">
          <div>
            <div class="room-name">${room.name}</div>
            <div style="font-size:11px; color:var(--text-muted);">Current Load: <strong>${roomTotalWatts} W</strong></div>
          </div>
          ${presenceTag}
        </div>
        <div style="display:flex; flex-direction:column; gap:8px;">
          ${appliancesHTML}
        </div>
        <div style="display:flex; gap:8px; margin-top:4px;">
          <button class="btn btn-danger" style="flex:1; font-size:11px; padding:6px;" onclick="cutOffRoom('${room.id}')">Force Cutoff</button>
        </div>
      `;
      container.appendChild(card);
    });

    calculateTotals();
    renderClassroomLayout();
  }

  function renderSimControls() {
    const list = document.getElementById('simRoomControlsList');
    if (!list) return;
    list.innerHTML = '';

    state.rooms.forEach(room => {
      const row = document.createElement('div');
      row.className = 'sim-room-row';
      const isOccupied = room.presence === 'occupied';

      row.innerHTML = `
        <div>
          <div style="font-size:12px; font-weight:700; color:#fff;">${room.name}</div>
          <div style="font-size:10px; color:${isOccupied ? 'var(--success)' : 'var(--text-muted)'};">
            ${isOccupied ? `● Occupied (${room.occupants}/${room.capacity || 20})` : `○ Vacant (${room.unattendedMinutes}m)`}
          </div>
        </div>
        <div style="display:flex; gap:6px;">
          <button class="btn" style="padding:4px 8px; font-size:10px; background:${isOccupied ? 'var(--primary)' : '#1e293b'}; color:${isOccupied ? '#000' : '#fff'};" onclick="forceRoomPresence('${room.id}', 'occupied')">Occupied</button>
          <button class="btn" style="padding:4px 8px; font-size:10px; background:${!isOccupied ? 'var(--danger)' : '#1e293b'}; color:#fff;" onclick="forceRoomPresence('${room.id}', 'vacant')">Vacant</button>
        </div>
      `;
      list.appendChild(row);
    });
  }

  function renderUserPortal() {
    const room = state.rooms.find(r => r.id === "204");
    const container = document.getElementById('userApplianceList');
    if (!container || !room) return;
    container.innerHTML = '';

    const pBadge = document.getElementById('userRoomPresenceBadge');
    if (pBadge) {
      pBadge.className = `badge-tag ${room.presence === 'occupied' ? 'tag-occupied' : 'tag-vacant'}`;
      pBadge.innerText = room.presence === 'occupied' ? "Presence Detected" : `Vacant: ${room.unattendedMinutes}m`;
    }

    const pStatus = document.getElementById('userPresenceStatus');
    if (pStatus) pStatus.innerText = room.presence === 'occupied' ? "Occupied" : "Vacant";

    const pReason = document.getElementById('userPresenceReason');
    if (pReason) pReason.innerText = room.radarVitalDetected ? "Vital Signs Detected (60GHz mmWave)" : "No Micro-Presence";
    
    const countdown = document.getElementById('userPresenceCountdown');
    if (countdown) {
      if (room.presence === 'occupied') {
        countdown.innerText = "Reset (0m elapsed)";
        countdown.style.color = "var(--success)";
      } else {
        countdown.innerText = `${room.unattendedMinutes} Minutes Unattended`;
        countdown.style.color = "var(--danger)";
      }
    }

    room.appliances.forEach(app => {
      const row = document.createElement('div');
      row.className = 'appliance-row';
      row.innerHTML = `
        <div>
          <div class="appliance-name" style="font-size:14px;">${app.icon || ''} ${app.name}</div>
          <div class="appliance-draw">${app.on ? app.baseWatts + ' W active draw' : 'Powered Down'}</div>
        </div>
        <label class="switch">
          <input type="checkbox" ${app.on ? 'checked' : ''} onchange="toggleAppliance('${room.id}', '${app.id}')">
          <span class="slider"></span>
        </label>
      `;
      container.appendChild(row);
    });
  }

  function calculateTotals() {
    let total = 0;
    state.rooms.forEach(r => {
      r.appliances.forEach(a => {
        if (a.on) total += a.baseWatts;
      });
    });
    const el = document.getElementById('adminTotalWatts');
    if (el) el.innerText = total.toLocaleString();

    const zCount = document.getElementById('activeZoneCount');
    if (zCount) zCount.innerText = state.rooms.length;
  }

  function toggleAppliance(roomId, applianceId) {
    const room = state.rooms.find(r => r.id === roomId);
    const app = room.appliances.find(a => a.id === applianceId);
    app.on = !app.on;
    
    logTelemetry(room.name, `cmd/${roomId}/relay/${app.id}`, app.on ? "RELAY_ENGAGED" : "RELAY_OPENED");
    renderAdminRooms();
    renderUserPortal();
  }

  function cutOffRoom(roomId) {
    const room = state.rooms.find(r => r.id === roomId);
    let wattsCut = 0;
    room.appliances.forEach(a => {
      if (a.on) {
        wattsCut += a.baseWatts;
        a.on = false;
      }
    });
    state.cutoffsCount++;
    const el = document.getElementById('adminCutoffCount');
    if (el) el.innerText = state.cutoffsCount;
    logTelemetry(room.name, `cmd/${roomId}/kill_switch`, "FORCE_ISOLATE_ALL");
    
    updateLeaderboardDynamically(room.blockId, wattsCut);
    renderAdminRooms();
    renderUserPortal();
  }

  function forceRoomPresence(roomId, newState) {
    const room = state.rooms.find(r => r.id === roomId);
    const wasVacant = room.presence === 'vacant';

    room.presence = newState;
    room.unattendedMinutes = 0;
    room.radarVitalDetected = (newState === 'occupied');
    
    logTelemetry(room.name, `telemetry/${roomId}/radar`, `Presence=${newState.toUpperCase()} (Manual Override)`);

    if (newState === 'occupied' && wasVacant) {
      room.appliances.forEach(app => {
        if (app.type === 'ac' || app.type === 'ambient') {
          if (!app.on) {
            app.on = true;
            logTelemetry(room.name, `cmd/${roomId}/auto_restore/${app.id}`, `PRESENCE_RESUMED_ON (${app.baseWatts}W)`);
          }
        }
      });
      if (room.occupants === 0) {
        room.occupants = room.capacity || 20;
      }
    } else if (newState === 'vacant') {
      room.occupants = 0;
    }

    const statusMains = document.getElementById('radarStatusMains');
    if (statusMains) {
      statusMains.innerText = "Status: Normal";
      statusMains.style.color = "var(--text-main)";
    }

    calculateTotals();
    renderAdminRooms();
    renderSimControls();
    if (state.currentRole === 'user') renderUserPortal();
  }

  function advanceTime(mins) {
    state.rooms.forEach(r => {
      if (r.presence === 'vacant') {
        r.unattendedMinutes += mins;
      }
    });
    evaluateWatchdogRules();
    renderAdminRooms();
    renderSimControls();
    if (state.currentRole === 'user') renderUserPortal();
  }

  function logTelemetry(room, topic, action) {
    const tbody = document.getElementById('telemetryLogBody');
    if (!tbody) return;
    const row = document.createElement('tr');
    const time = new Date().toLocaleTimeString();
    row.innerHTML = `
      <td style="color:var(--text-muted);">${time}</td>
      <td><strong>${room}</strong></td>
      <td style="font-family:monospace; color:var(--primary);">${topic}</td>
      <td><span style="font-weight:700;">${action}</span></td>
    `;
    tbody.prepend(row);
    if (tbody.children.length > 8) tbody.removeChild(tbody.lastChild);
  }

  let chart;
  function initChart() {
    const canvas = document.getElementById('energyChart');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    const labels = Array.from({length: 12}, (_, i) => `${12 - i}s ago`).reverse();
    const data = [3800, 3900, 3850, 4100, 4150, 4200, 4120, 4180, 4090, 4120, 4150, 4120];

    chart = new Chart(ctx, {
      type: 'line',
      data: {
        labels: labels,
        datasets: [{
          label: 'Mains Active Power (Watts)',
          data: data,
          borderColor: '#38bdf8',
          backgroundColor: 'rgba(56, 189, 248, 0.08)',
          fill: true,
          tension: 0.35,
          borderWidth: 2
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        scales: {
          x: { grid: { color: '#1a2333' }, ticks: { color: '#64748b' } },
          y: { grid: { color: '#1a2333' }, ticks: { color: '#64748b' } }
        },
        plugins: { legend: { display: false } }
      }
    });

    setInterval(() => {
      const el = document.getElementById('adminTotalWatts');
      let currentTotal = el ? (parseInt(el.innerText.replace(/,/g, '')) || 0) : 0;
      let jitter = Math.floor(Math.random() * 50) - 25;
      let nextVal = Math.max(0, currentTotal + jitter);

      if (chart && chart.data && chart.data.datasets[0]) {
        chart.data.datasets[0].data.shift();
        chart.data.datasets[0].data.push(nextVal);
        chart.update('none');
      }
    }, 2000);
  }

  function evaluateWatchdogRules() {
    let actionsTaken = 0;

    state.rooms.forEach(room => {
      if (room.presence === 'vacant') {
        room.appliances.forEach(app => {
          if (app.on) {
            let triggered = false;
            let ruleLabel = "";

            if (app.type === 'hazard' && room.unattendedMinutes >= 5) {
              ruleLabel = "HAZARD_TIMEOUT_5M";
              triggered = true;
            } else if (app.type === 'ac' && room.unattendedMinutes >= 15) {
              ruleLabel = "AC_TIMEOUT_15M";
              triggered = true;
            } else if (app.type === 'ambient' && room.unattendedMinutes >= 20) {
              ruleLabel = "LIGHT_FAN_TIMEOUT_20M";
              triggered = true;
            }

            if (triggered) {
              logTelemetry(room.name, `watchdog/auto_kill/${app.id}`, `${ruleLabel} (${app.baseWatts}W)`);
              app.on = false;
              state.cutoffsCount++;
              actionsTaken++;
              updateLeaderboardDynamically(room.blockId, app.baseWatts);
            }
          }
        });
      }
    });

    const el = document.getElementById('adminCutoffCount');
    if (el) el.innerText = state.cutoffsCount;

    const statusMains = document.getElementById('radarStatusMains');
    if (statusMains) {
      if (actionsTaken > 0) {
        statusMains.innerText = `Watchdog Cut ${actionsTaken} Device(s)`;
        statusMains.style.color = "var(--danger)";
      } else {
        statusMains.innerText = "Status: Normal";
        statusMains.style.color = "var(--text-main)";
      }
    }

    calculateTotals();
    renderClassroomLayout();
  }

  setInterval(() => {
    state.rooms.forEach(room => {
      if (room.presence === 'vacant') {
        room.unattendedMinutes += 1;
        logTelemetry(room.name, `telemetry/${room.id}/occupancy_timer`, `Vacant=${room.unattendedMinutes}m`);
      } else {
        room.unattendedMinutes = 0;
      }
    });

    evaluateWatchdogRules();
    renderAdminRooms();
    renderSimControls();
    if (state.currentRole === 'user') renderUserPortal();
  }, 10000);

  setInterval(() => {
    updateLeaderboardDynamically(null, 0);
  }, 14000);

  // Initialize
  renderRoomTabs();
  renderAdminRooms();
  renderSimControls();
  renderLeaderboard();
  initChart();
  initDraggablePanel();
  renderClassroomLayout();
</script>

</body>
</html>
