<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>VoltSense IoT Energy & Automated Sensor Watchdog Platform</title>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<style>
  :root {
    --bg-dark: #090d16;
    --card-bg: #111827;
    --card-border: #1f293d;
    --primary: #38bdf8;
    --primary-glow: rgba(56, 189, 248, 0.2);
    --text-light: #f8fafc;
    --text-muted: #94a3b8;
    --success: #10b981;
    --danger: #ef4444;
    --warning: #f59e0b;
    --accent: #6366f1;
    --gold: #fbbf24;
    --silver: #94a3b8;
    --bronze: #d97706;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
  body { background-color: var(--bg-dark); color: var(--text-light); min-height: 100vh; display: flex; flex-direction: column; }

  header {
    background: var(--card-bg);
    border-bottom: 1px solid var(--card-border);
    padding: 14px 28px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .brand { display: flex; align-items: center; gap: 10px; }
  .brand h1 { font-size: 20px; font-weight: 800; letter-spacing: -0.5px; }
  .brand h1 span { color: var(--primary); }
  .nav-controls { display: flex; align-items: center; gap: 16px; }
  
  .role-toggle {
    display: flex;
    background: #1e293b;
    border-radius: 8px;
    padding: 3px;
    border: 1px solid var(--card-border);
  }
  .role-btn {
    padding: 6px 14px;
    font-size: 13px;
    font-weight: 600;
    border: none;
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    border-radius: 6px;
    transition: 0.2s;
  }
  .role-btn.active { background: var(--primary); color: #000; }

  .broker-status {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: var(--text-muted);
    border: 1px solid var(--card-border);
    padding: 5px 12px;
    border-radius: 20px;
    background: #141c2e;
  }
  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--success);
    box-shadow: 0 0 8px var(--success);
  }

  main { flex: 1; padding: 24px 28px; max-width: 1600px; margin: 0 auto; width: 100%; display: flex; flex-direction: column; gap: 24px; }

  .view-section { display: none; flex-direction: column; gap: 24px; }
  .view-section.active { display: flex; }

  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
  }
  .metric-card {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 14px;
    padding: 18px 20px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    position: relative;
    overflow: hidden;
  }
  .metric-title { font-size: 12px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px; }
  .metric-value { font-size: 32px; font-weight: 800; color: #fff; }
  .metric-subtitle { font-size: 11px; color: var(--text-muted); display: flex; align-items: center; gap: 4px; }

  .split-layout { display: grid; grid-template-columns: 2fr 1.2fr; gap: 24px; }
  @media (max-width: 1080px) { .split-layout { grid-template-columns: 1fr; } }

  .panel-card {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 16px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .panel-header { display: flex; justify-content: space-between; align-items: center; }
  .panel-title { font-size: 15px; font-weight: 700; color: #fff; }

  .room-cards-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 16px; }
  .room-box {
    background: #141c2e;
    border: 1px solid var(--card-border);
    border-radius: 12px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    position: relative;
    transition: 0.3s;
  }
  .room-box.hazard-border { border-color: var(--danger); box-shadow: 0 0 12px rgba(239, 68, 68, 0.2); }
  .room-header { display: flex; justify-content: space-between; align-items: center; }
  .room-name { font-size: 15px; font-weight: 700; }
  .badge-tag { font-size: 10px; padding: 3px 8px; border-radius: 20px; font-weight: 700; text-transform: uppercase; }
  .tag-occupied { background: rgba(16, 185, 129, 0.15); color: var(--success); }
  .tag-vacant { background: rgba(148, 163, 184, 0.15); color: var(--text-muted); }
  .tag-hazard { background: rgba(239, 68, 68, 0.2); color: var(--danger); }

  .appliance-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #0d1322;
    padding: 10px 12px;
    border-radius: 8px;
    border: 1px solid #1c273e;
  }
  .appliance-name { font-size: 13px; font-weight: 600; display: flex; align-items: center; gap: 6px; }
  .appliance-draw { font-size: 12px; color: var(--text-muted); }

  .switch { position: relative; display: inline-block; width: 40px; height: 22px; }
  .switch input { opacity: 0; width: 0; height: 0; }
  .slider {
    position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0;
    background-color: #334155; transition: .25s; border-radius: 22px;
  }
  .slider:before {
    position: absolute; content: ""; height: 16px; width: 16px; left: 3px; bottom: 3px;
    background-color: white; transition: .25s; border-radius: 50%;
  }
  input:checked + .slider { background-color: var(--primary); }
  input:checked + .slider:before { transform: translateX(18px); }

  .btn {
    padding: 8px 16px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    border: none;
    transition: 0.2s;
  }
  .btn-danger { background: var(--danger); color: #fff; }
  .btn-danger:hover { opacity: 0.9; }
  .btn-primary { background: var(--primary); color: #000; }
  .btn-primary:hover { opacity: 0.9; }

  .log-table { width: 100%; border-collapse: collapse; font-size: 12px; }
  .log-table th { text-align: left; padding: 10px; color: var(--text-muted); border-bottom: 1px solid var(--card-border); font-weight: 600; }
  .log-table td { padding: 10px; border-bottom: 1px solid #162032; }

  .leaderboard-list { display: flex; flex-direction: column; gap: 10px; }
  .leaderboard-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #0d1322;
    border: 1px solid var(--card-border);
    border-radius: 10px;
    padding: 12px 16px;
    transition: transform 0.3s ease, border-color 0.2s ease;
  }
  .leaderboard-item:hover { border-color: var(--primary); background: #131b2e; }
  .rank-badge {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 12px;
  }
  .rank-1 { background: rgba(251, 191, 36, 0.2); color: var(--gold); border: 1px solid var(--gold); }
  .rank-2 { background: rgba(148, 163, 184, 0.2); color: var(--silver); border: 1px solid var(--silver); }
  .rank-3 { background: rgba(217, 119, 6, 0.2); color: var(--bronze); border: 1px solid var(--bronze); }
  .rank-other { background: #1e293b; color: var(--text-muted); }

  .block-info h4 { font-size: 13px; font-weight: 700; color: #fff; }
  .block-info p { font-size: 11px; color: var(--text-muted); }
  .score-val { font-size: 14px; font-weight: 800; color: var(--success); }

  /* Visual Floorplan */
  .classroom-plan {
    position: relative;
    background: #1e293b;
    border: 2px solid var(--card-border);
    border-radius: 14px;
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    transition: background 0.4s ease, border-color 0.4s ease, box-shadow 0.4s ease;
  }

  .classroom-plan.lights-out {
    background: #030712 !important;
    border-color: #111827 !important;
    box-shadow: inset 0 0 45px rgba(0, 0, 0, 0.95);
  }
  .classroom-plan.lights-out .blackboard,
  .classroom-plan.lights-out .desk {
    opacity: 0.35;
    filter: brightness(0.45);
  }
  .classroom-plan.lights-out .appliance-badge {
    opacity: 0.4;
  }

  .room-selector-tabs {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding-bottom: 2px;
  }
  .room-tab-btn {
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 700;
    border-radius: 8px;
    background: #1e293b;
    border: 1px solid var(--card-border);
    color: var(--text-muted);
    cursor: pointer;
    white-space: nowrap;
    transition: 0.2s;
  }
  .room-tab-btn.active {
    background: var(--primary);
    color: #000;
    border-color: var(--primary);
  }

  .room-fixture-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px dashed rgba(148, 163, 184, 0.25);
    padding-bottom: 12px;
    flex-wrap: wrap;
    gap: 10px;
  }

  .blackboard {
    background: #0f3822;
    border: 3px solid #854d0e;
    border-radius: 6px;
    padding: 8px 24px;
    color: #e2e8f0;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .appliance-badge {
    background: #0d1322;
    border: 1px solid var(--card-border);
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 11px;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 6px;
    transition: opacity 0.3s;
  }
  .appliance-badge.active-load {
    border-color: var(--primary);
    color: var(--primary);
    box-shadow: 0 0 10px var(--primary-glow);
  }
  .appliance-badge.active-hazard {
    border-color: var(--danger);
    color: var(--danger);
    box-shadow: 0 0 10px rgba(239, 68, 68, 0.3);
  }

  .seating-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 14px;
    margin-top: 4px;
  }

  .desk {
    background: #0f172a;
    border: 2px solid var(--card-border);
    border-radius: 10px;
    padding: 12px 8px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    transition: transform 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
  }
  .desk:hover {
    transform: translateY(-2px);
  }
  .desk-seat {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    transition: background-color 0.25s ease, box-shadow 0.25s ease;
  }
  .desk.occupied {
    border-color: rgba(16, 185, 129, 0.4);
    background: rgba(16, 185, 129, 0.06);
  }
  .desk.occupied .desk-seat {
    background: var(--success);
    box-shadow: 0 0 10px rgba(16, 185, 129, 0.7);
  }
  .desk.vacant {
    border-color: rgba(239, 68, 68, 0.4);
    background: rgba(239, 68, 68, 0.04);
  }
  .desk.vacant .desk-seat {
    background: var(--danger);
    box-shadow: 0 0 8px rgba(239, 68, 68, 0.5);
  }
  .desk-label {
    font-size: 11px;
    font-weight: 700;
    color: var(--text-muted);
  }

  .counter-stepper {
    display: flex;
    align-items: center;
    gap: 12px;
    background: #0d1322;
    padding: 6px 12px;
    border-radius: 8px;
    border: 1px solid var(--card-border);
  }
  .step-btn {
    width: 28px;
    height: 28px;
    background: #1e293b;
    border: 1px solid var(--card-border);
    color: #fff;
    border-radius: 6px;
    font-weight: 800;
    font-size: 16px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .step-btn:hover {
    background: var(--primary);
    color: #000;
  }

  /* Draggable Simulation Panel */
  .sim-control-panel {
    position: fixed;
    top: 120px;
    right: 24px;
    width: 380px;
    background: var(--card-bg);
    border: 2px solid var(--accent);
    border-radius: 12px;
    padding: 0;
    z-index: 1000;
    display: flex;
    flex-direction: column;
    box-shadow: 0 16px 40px rgba(0,0,0,0.7);
    user-select: none;
  }

  .sim-header-draggable {
    background: #1e293b;
    padding: 12px 16px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    cursor: grab;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--card-border);
  }
  .sim-header-draggable:active {
    cursor: grabbing;
  }

  .sim-content {
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-height: 480px;
    overflow-y: auto;
  }

  .sim-room-row {
    background: #0d1322;
    border: 1px solid var(--card-border);
    border-radius: 8px;
    padding: 8px 12px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
</style>
</head>
<body>

<header>
  <div class="brand">
    <h1>⚡ Volt<span>Sense</span></h1>
    <span style="font-size: 11px; color: var(--text-muted); border-left: 1px solid var(--card-border); padding-left: 10px;">VIT Green Campus Energy Grid</span>
  </div>

  <div class="nav-controls">
    <div class="broker-status">
      <div class="pulse-dot"></div>
      <span>MQTT: <strong>emqx.vit.ac.in</strong></span>
    </div>
    <div class="role-toggle">
      <button class="role-btn active" onclick="switchRole('admin')">Facility Admin</button>
      <button class="role-btn" onclick="switchRole('user')">Student Portal</button>
    </div>
  </div>
</header>

<main>

  <section id="adminView" class="view-section active">
    <div class="metrics-grid">
      <div class="metric-card">
        <div class="metric-title">Campus Live Draw</div>
        <div class="metric-value"><span id="adminTotalWatts">4,120</span> W</div>
        <div class="metric-subtitle"><span style="color:var(--success);">● TimescaleDB</span> Ingest (1000ms chunk)</div>
      </div>
      <div class="metric-card">
        <div class="metric-title">Active Monitored Zones</div>
        <div class="metric-value"><span id="activeZoneCount">3</span> <span style="font-size: 16px; color: var(--text-muted);">Rooms Active</span></div>
        <div class="metric-subtitle">60 GHz mmWave Radar Armed</div>
      </div>
      <div class="metric-card">
        <div class="metric-title">Auto-Cutoffs Executed</div>
        <div class="metric-value" style="color: var(--warning);" id="adminCutoffCount">14</div>
        <div class="metric-subtitle"><span id="totalAvoidedKwhText">~ 6.2 kWh</span> wasted power avoided</div>
      </div>
      <div class="metric-card">
        <div class="metric-title">Campus Eco-Score</div>
        <div style="font-size:32px; color:var(--success); font-weight:800;" id="campusEcoScore">94.2%</div>
        <div class="metric-subtitle">VIT Real-time Dynamic Index</div>
      </div>
    </div>

    <div class="split-layout">
      <div class="panel-card">
        <div class="panel-header">
          <div class="panel-title">Real-Time Load Stream (Mains & NILM)</div>
          <span style="font-size: 11px; color: var(--text-muted);">Aggregated via Redis & TimescaleDB</span>
        </div>
        <div style="height: 260px;">
          <canvas id="energyChart"></canvas>
        </div>
      </div>

      <div class="panel-card">
        <div class="panel-header">
          <div class="panel-title">🏆 VIT Campus Efficiency Leaderboard</div>
          <span class="badge-tag tag-occupied">Live Auto-Ranked</span>
        </div>
        <div class="leaderboard-list" id="campusLeaderboard"></div>
      </div>
    </div>

    <div class="panel-card">
      <div class="panel-header" style="flex-wrap: wrap; gap: 12px;">
        <div>
          <div class="panel-title" id="visualizerTitle">Visual Room Floorplan & Spatial Occupancy</div>
          <span style="font-size: 11px; color: var(--text-muted);">Green = Occupied • Red = Vacant • Lights switch triggers room dark theme</span>
        </div>

        <div style="display:flex; align-items:center; gap:12px;">
          <div class="room-selector-tabs" id="roomSelectorTabs"></div>

          <div class="counter-stepper">
            <span style="font-size:11px; font-weight:700; color:var(--text-muted);">OCCUPANTS:</span>
            <button class="step-btn" onclick="adjustStudentCount(-1)">−</button>
            <span id="studentCountLabel" style="font-size:14px; font-weight:800; color:var(--primary); min-width:55px; text-align:center;">6 / 6</span>
            <button class="step-btn" onclick="adjustStudentCount(1)">+</button>
          </div>
        </div>
      </div>

      <div class="classroom-plan" id="classroomFloorplan">
        <div class="room-fixture-bar">
          <div style="display:flex; gap:10px; flex-wrap:wrap;" id="activeRoomFixtureBadges"></div>
          <div class="blackboard" id="roomFocalPoint">STUDY / COMMON WORKBENCH</div>
        </div>

        <div class="seating-grid" id="seatingGrid"></div>
      </div>
    </div>

    <div class="panel-card">
      <div class="panel-header">
        <div class="panel-title">Active Facility Blocks & Remote Relay Controls</div>
        <span style="font-size: 12px; color: var(--text-muted);">Dual-Sensor Fusion: mmWave + NILM</span>
      </div>
      <div class="room-cards-grid" id="adminRoomGrid"></div>
    </div>

    <div class="panel-card">
      <div class="panel-header">
        <div class="panel-title">MQTT Telemetry & FSM Engine Log</div>
        <span class="badge-tag tag-occupied">Autopilot Armed</span>
      </div>
      <div style="overflow-y: auto; max-height: 180px;">
        <table class="log-table">
          <thead>
            <tr>
              <th>Timestamp</th>
              <th>Room / Zone</th>
              <th>Topic / Event</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody id="telemetryLogBody"></tbody>
        </table>
      </div>
    </div>
  </section>

  <section id="userView" class="view-section">
    <div class="panel-card" style="background: linear-gradient(145deg, #162035, #0f172a); border-color: #2b3b5b;">
      <div class="panel-header">
        <div>
          <div class="panel-title" style="font-size: 18px;">Welcome, Priyansh (Assigned: Electronics Lab 204 • TT Block)</div>
          <div style="font-size: 12px; color: var(--text-muted); margin-top: 4px;">
            Active Reservation: <strong>Slot #B-12 (2:00 PM – 4:00 PM)</strong> • Eco Badge: <strong id="studentPortalBadge">Top Energy Saver</strong>
          </div>
        </div>
      </div>
    </div>

    <div class="split-layout">
      <div class="panel-card">
        <div class="panel-header">
          <div class="panel-title">Your Room Appliance Toggles (Relay Actuation)</div>
          <span class="badge-tag tag-occupied" id="userRoomPresenceBadge">Presence Detected</span>
        </div>
        <div style="display:flex; flex-direction: column; gap: 12px;" id="userApplianceList"></div>
      </div>

      <div style="display:flex; flex-direction:column; gap:20px;">
        <div class="panel-card">
          <div class="panel-header">
            <div class="panel-title">Your Block Energy Standing</div>
            <span class="badge-tag tag-occupied" id="userBlockRankBadge">Hostel Rank #1</span>
          </div>
          <div style="font-size:13px; color:var(--text-muted); line-height:1.5;" id="userBlockDesc">
            Loading real-time block metrics...
          </div>
        </div>

        <div class="panel-card">
          <div class="panel-header">
            <div class="panel-title">Room 204: 60 GHz mmWave Radar Feed</div>
            <span class="badge-tag tag-occupied">Sensor Armed</span>
          </div>
          <div style="background: #0d1322; border: 1px solid var(--card-border); border-radius: 10px; padding: 14px; display:flex; flex-direction:column; gap:8px;">
            <div style="display:flex; justify-content: space-between;">
              <span style="font-size: 13px; color: var(--text-muted);">Occupancy State</span>
              <span style="font-size: 13px; font-weight: 700;" id="userPresenceStatus">Occupied</span>
            </div>
            <div style="display:flex; justify-content: space-between;">
              <span style="font-size: 13px; color: var(--text-muted);">Sensor Telemetry</span>
              <span style="font-size: 12px; color: var(--primary); font-family: monospace;" id="userPresenceReason">Vital Signs Detected</span>
            </div>
            <div style="display:flex; justify-content: space-between;">
              <span style="font-size: 13px; color: var(--text-muted);">Vacancy Countdown</span>
              <span style="font-size: 13px; color: var(--success);" id="userPresenceCountdown">Reset (0m elapsed)</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

</main>

<div class="sim-control-panel" id="draggableSimPanel">
  <div class="sim-header-draggable" id="simDragHandle">
    <div style="display:flex; align-items:center; gap:8px;">
      <span style="cursor:grab;">⠿</span>
      <h4 style="font-size: 13px; color: #fff; margin:0;">Sensor Controls</h4>
    </div>
    <span class="badge-tag" style="background: var(--accent); color: #fff; font-size:10px;">Drag Me</span>
  </div>

  <div class="sim-content">
    <p style="font-size: 11px; color: var(--text-muted); margin:0;">
      Toggle room states. Relays automatically respond, avoid waste, and re-rank leaderboard standings.
    </p>
    
    <div id="simRoomControlsList" style="display:flex; flex-direction:column; gap:8px;"></div>

    <div style="border-top: 1px solid var(--card-border); padding-top: 10px; display:flex; gap: 6px;">
      <button class="btn btn-primary" style="flex: 1; font-size: 11px; padding:6px;" onclick="advanceTime(5)">+5 Mins</button>
